# .dockerignore for the commit-image build.
# Goal: bake in the FULL repo (including .git history — the grader uses it),
# dropping only local build artifacts and editor/OS cruft. Dev image, not minimal.

# ── Build outputs / local cruft ──────────────────────────────────────────────
# build.sh produces its outputs under /mayhem at build time; keep host-built
# autotools/libtool artifacts out of the context so they can't shadow the build.
.deps/
.libs/
**/.deps/
**/.libs/
.dirstamp
**/.dirstamp
autom4te.cache/
build-aux/
mayhem-oracle
standalone_main.o
*.o
*.lo
*.a
*.la
*.so
*.so.*
ctrf-report.json

# autotools-generated files (regenerated by build.sh ./autogen.sh)
Makefile
Makefile.in
config.h
config.h.in
config.log
config.status
libtool
stamp-*

# ── Editor / OS noise ────────────────────────────────────────────────────────
.DS_Store
*.swp
*~
